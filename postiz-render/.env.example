# =============================================================================
# Postiz — poore environment variables ka reference (Render + local testing)
# =============================================================================
# Render par ye values render.yaml + Dashboard -> Environment se aati hain.
# Ye file sirf reference/local docker-compose ke liye hai.
# Kabhi bhi asli secrets commit na karo (ye file sirf placeholder dikhati hai).
# =============================================================================

# --- Public URL (Render par entrypoint khud RENDER_EXTERNAL_URL se bhar deta hai)
MAIN_URL="https://postiz-xxxx.onrender.com"
FRONTEND_URL="https://postiz-xxxx.onrender.com"
NEXT_PUBLIC_BACKEND_URL="https://postiz-xxxx.onrender.com/api"
BACKEND_INTERNAL_URL="http://localhost:3000"

# --- Secrets (render.yaml me generateValue: true hai)
# Generate: openssl rand -base64 32
JWT_SECRET="CHANGE-ME-long-random-string"

# --- Data stores (Render par fromDatabase / fromService se auto-set hote hain)
DATABASE_URL="postgresql://postiz:password@postiz-db-host:5432/postiz"
REDIS_URL="redis://red-xxxxxxxxxxxx:6379"
TEMPORAL_ADDRESS="temporal-xxxx:7233"

# --- Self-hosting essentials
IS_GENERAL="true"              # self-hosting ke liye zaroori
RUN_CRON="true"
DISABLE_REGISTRATION="false"   # pehla signup ke baad "true" kar dena

# --- Storage
# "cloudflare" = Cloudflare R2 (FREE 10 GB, Render par recommended)
# "local"      = container/filesystem (Render par ephemeral — restart par udd jayega)
STORAGE_PROVIDER="cloudflare"
UPLOAD_DIRECTORY="/uploads"
NEXT_PUBLIC_UPLOAD_DIRECTORY="/uploads"
# NEXT_PUBLIC_UPLOAD_STATIC_DIRECTORY=""   # optional: public bucket URL se files serve karne ke liye

# Cloudflare R2 -> https://dash.cloudflare.com/r2
# Setup guide: docs/03-storage.md
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ACCESS_KEY=""
CLOUDFLARE_SECRET_ACCESS_KEY=""
CLOUDFLARE_BUCKETNAME="postiz"
CLOUDFLARE_BUCKET_URL="https://my-bucket.example.com"
CLOUDFLARE_REGION="auto"       # Cloudflare dashboard jo dikhaye (auto/wnam/...)

# --- Email (agar chahiye: naye users ko activation email jaayegi)
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS=""
# EMAIL_FROM_NAME="Postiz"
# EMAIL_PROVIDER="resend"

# --- AI features (optional)
# OPENAI_API_KEY=""

# =============================================================================
# Social media providers — sirf wahi set karo jo use karna hai.
# Har provider ka apna developer portal hai; redirect URL hamesha ye hota hai:
#    https://<aapka-postiz-url>/api/integrations/social/<provider>
# Steps: docs/04-social-providers.md
# =============================================================================

# X (Twitter)
# X_API_KEY=""
# X_API_SECRET=""

# LinkedIn
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Instagram / Facebook / Threads (Meta)
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""
# THREADS_APP_ID=""
# THREADS_APP_SECRET=""

# YouTube (Google)
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""

# TikTok
# TIKTOK_CLIENT_ID=""
# TIKTOK_CLIENT_SECRET=""

# Pinterest
# PINTEREST_CLIENT_ID=""
# PINTEREST_CLIENT_SECRET=""

# Reddit
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# GitHub
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Discord
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# DISCORD_BOT_TOKEN_ID=""

# Slack
# SLACK_ID=""
# SLACK_SECRET=""
# SLACK_SIGNING_SECRET=""

# Mastodon
# MASTODON_URL="https://mastodon.social"
# MASTODON_CLIENT_ID=""
# MASTODON_CLIENT_SECRET=""

# Dribbble
# DRIBBBLE_CLIENT_ID=""
# DRIBBBLE_CLIENT_SECRET=""
