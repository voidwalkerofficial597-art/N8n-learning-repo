# =============================================================================
#  OPTIONAL environment variables for Postiz on Render
#
#  How to use:
#    1. Copy ONLY the lines you need (remove the leading '#'), fill in the values.
#    2. Render dashboard -> service "postiz" -> Environment -> "Add from .env" -> paste.
#    3. Save -> Render redeploys automatically.
#
#  DO NOT commit real keys to git. This file is a reference only; render.yaml
#  intentionally does not list these so a Blueprint sync never overwrites them.
#
#  Provider setup guides: https://docs.postiz.com/self-host/providers/<provider>   (e.g. .../linkedin)
#  Full reference:        https://docs.postiz.com/self-host/configuration/reference
#
#  OAuth callback URL for every provider is:
#    https://<your-postiz-domain>/integrations/social/<provider>
#  e.g. https://postiz.onrender.com/integrations/social/linkedin
# =============================================================================

# --- Custom domain (only if you attach one in Render -> Settings -> Custom Domains) ---
# MAIN_URL="https://postiz.yourdomain.com"

# --- AI features ---
# OPENAI_API_KEY=""

# --- E-mail (Resend). WARNING: as soon as RESEND_API_KEY is set, new users must
#     confirm their e-mail before they can log in. ---
# RESEND_API_KEY=""
# EMAIL_FROM_ADDRESS="postiz@yourdomain.com"
# EMAIL_FROM_NAME="Postiz"

# --- Social providers --------------------------------------------------------
# X (Twitter)
# X_API_KEY=""
# X_API_SECRET=""

# LinkedIn (personal + pages)
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""

# Facebook Pages + Instagram (same Meta app)
# FACEBOOK_APP_ID=""
# FACEBOOK_APP_SECRET=""

# Threads
# THREADS_APP_ID=""
# THREADS_APP_SECRET=""

# YouTube
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""

# TikTok
# TIKTOK_CLIENT_ID=""
# TIKTOK_CLIENT_SECRET=""

# Pinterest
# PINTEREST_CLIENT_ID=""
# PINTEREST_CLIENT_SECRET=""

# Reddit
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# Discord
# DISCORD_CLIENT_ID=""
# DISCORD_CLIENT_SECRET=""
# DISCORD_BOT_TOKEN_ID=""

# Slack
# SLACK_ID=""
# SLACK_SECRET=""
# SLACK_SIGNING_SECRET=""

# Mastodon
# MASTODON_URL="https://mastodon.social"
# MASTODON_CLIENT_ID=""
# MASTODON_CLIENT_SECRET=""

# Dribbble / Tumblr / GitHub
# DRIBBBLE_CLIENT_ID=""
# DRIBBBLE_CLIENT_SECRET=""
# TUMBLR_CLIENT_ID=""
# TUMBLR_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Newsletters
# BEEHIIVE_API_KEY=""
# BEEHIIVE_PUBLICATION_ID=""
# LISTMONK_DOMAIN=""
# LISTMONK_USER=""
# LISTMONK_API_KEY=""
# LISTMONK_LIST_ID=""

# --- Media storage on Cloudflare R2 instead of the Render disk ---
#     (set STORAGE_PROVIDER=cloudflare and remove UPLOAD_DIRECTORY / NEXT_PUBLIC_UPLOAD_DIRECTORY)
# STORAGE_PROVIDER="cloudflare"
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ACCESS_KEY=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# CLOUDFLARE_BUCKETNAME=""
# CLOUDFLARE_BUCKET_URL="https://<bucket>.r2.cloudflarestorage.com/"
# CLOUDFLARE_REGION="auto"

# --- Short links ---
# DUB_TOKEN=""
# SHORT_IO_SECRET_KEY=""
# KUTT_API_KEY=""

# --- Misc ---
# API_LIMIT=30                     # public API requests per hour
# NEXT_PUBLIC_DISCORD_SUPPORT=""   # link shown in the UI
# DISABLE_SSRF_PROTECTION=false    # keep false unless you know why you need it

# --- Single sign-on (generic OIDC, e.g. Authentik / Keycloak) ---
# POSTIZ_GENERIC_OAUTH="true"
# NEXT_PUBLIC_POSTIZ_OAUTH_DISPLAY_NAME="Authentik"
# NEXT_PUBLIC_POSTIZ_OAUTH_LOGO_URL=""
# POSTIZ_OAUTH_URL="https://auth.example.com"
# POSTIZ_OAUTH_AUTH_URL="https://auth.example.com/application/o/authorize"
# POSTIZ_OAUTH_TOKEN_URL="https://auth.example.com/application/o/token"
# POSTIZ_OAUTH_USERINFO_URL="https://auth.example.com/application/o/userinfo"
# POSTIZ_OAUTH_CLIENT_ID=""
# POSTIZ_OAUTH_CLIENT_SECRET=""

# --- Temporal (advanced; defaults are fine) ---
# EXCLUDE_QUEUE=""                 # comma-separated worker queues to skip (saves RAM)
# WORKER_CONCURRENCY_DIVIDER=""    # lower concurrency on small instances
